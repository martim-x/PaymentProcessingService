# --- API ---
# ОБЯЗАТЕЛЬНО: сервис не стартует с пустым/дефолтным значением
PAYMENT_API_KEY=change-this-api-key

# --- PostgreSQL ---
PAYMENT_DATABASE_URL=postgresql+psycopg://payment:payment@postgres:5432/payments

# --- RabbitMQ ---
PAYMENT_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PAYMENT_RABBITMQ_QUEUE=payments.new
PAYMENT_RABBITMQ_DLQ=payments.dlq
# один конвейер: обработка платежа и доставка webhook в одном handler

# --- Outbox relay ---
PAYMENT_RELAY_INTERVAL=1.0
PAYMENT_RELAY_BATCH=100

# --- Payment processing ---
PAYMENT_PROCESS_MIN_SECONDS=2.0
PAYMENT_PROCESS_MAX_SECONDS=5.0
PAYMENT_SUCCESS_RATE=0.9

# --- Webhook ---
PAYMENT_WEBHOOK_TIMEOUT=5.0
# ОБЯЗАТЕЛЬНО: HMAC-секрет подписи (X-Signature)
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
# true разрешает webhook на частные адреса (host.docker.internal) — только локальная разработка
PAYMENT_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# --- Consumer / outbox ---
PAYMENT_CLAIM_TTL_SECONDS=30.0
# дубликат сообщения ждёт освобождения клейма, прежде чем уйти в retry
PAYMENT_CLAIM_WAIT_SECONDS=15.0
PAYMENT_CLAIM_POLL_SECONDS=0.5
PAYMENT_CLAIM_FINALIZE_MARGIN_SECONDS=5.0
PAYMENT_OUTBOX_MAX_ATTEMPTS=10
PAYMENT_CONSUMER_PREFETCH=10
# клейм доставки webhook: TTL покрывает HTTP-таймаут + запас на финализацию
PAYMENT_WEBHOOK_CLAIM_TTL_SECONDS=30.0
# (своей лестницы TTL у webhook больше нет: повтор идёт по payments.new)

# --- Retries (RabbitMQ TTL-очереди) ---
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_DELAY=1.0
PAYMENT_RETRY_FACTOR=2.0
# база TTL лестницы для транзиентных сбоев БД/транспорта (общий бюджет PAYMENT_MAX_ATTEMPTS)
PAYMENT_INFRA_RETRY_BASE_DELAY=2.0
