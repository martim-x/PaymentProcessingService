# --- API ---
# ОБЯЗАТЕЛЬНО: сервис не стартует с пустым/дефолтным значением
PAYMENT_API_KEY=change-this-api-key

# --- PostgreSQL ---
PAYMENT_DATABASE_URL=postgresql+psycopg://payment:payment@postgres:5432/payments

# --- RabbitMQ ---
PAYMENT_RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672/
PAYMENT_RABBITMQ_QUEUE=payments.new

# --- Outbox relay ---
PAYMENT_RELAY_INTERVAL=1.0
PAYMENT_RELAY_BATCH=100

# --- Payment processing ---
PAYMENT_PROCESS_MIN_SECONDS=2.0
PAYMENT_PROCESS_MAX_SECONDS=5.0
PAYMENT_SUCCESS_RATE=0.9

# --- Webhook ---
PAYMENT_WEBHOOK_TIMEOUT=5.0
# ОБЯЗАТЕЛЬНО: HMAC-секрет подписи (X-Signature)
PAYMENT_WEBHOOK_SECRET=change-this-webhook-secret
# true разрешает webhook на частные адреса (host.docker.internal) — только локальный стенд
PAYMENT_WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# --- Retries (RabbitMQ TTL-очереди и webhook) ---
PAYMENT_MAX_ATTEMPTS=3
PAYMENT_RETRY_BASE_DELAY=1.0
PAYMENT_RETRY_FACTOR=2.0
